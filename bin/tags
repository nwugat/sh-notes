#!/usr/bin/env sh

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"
source "$SCRIPT_DIR/../lib/tags.sh"

indent_tags() {
  while IFS= read -r line; do
    local level=$(echo "$line" | tr -dc '/' | wc -c)
    for i in $(seq 1 "$level"); do
      printf '\t'
    done
    echo "$line"
  done
}

cmd_help() {
cat <<EOF
Usage:

h|help
p|print [[-x|--expand]|[-t|--tree]] [-i|--indent]
EOF
}

cmd_print() {
# "match mode": "single match", "expand match", "tree". Mutually exclusive
print_mode="single" # single|expand|tree
# only single & expand accept indenting
indent_filter=cat

# parse opts
while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--tree)
          print_mode="tree"
          shift
          ;;
        -x|--expand)
          print_mode="expand"
          shift
          ;;
        -i|--indent)
          indent_filter=indent_tags
          shift
          ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option for subcommand 'print': $1" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# print
#TODO implement indent
case $print_mode in
  "single")
    find_tags | "$SCRIPT_DIR/../scripts/process-tag-occurrences.py" | sort | $indent_filter
    exit 0
    ;;
  "expand")
    find_tags_expanded | sort | $indent_filter
    exit 0
    ;;
  "tree")
    find_tags | sort | uniq | "$SCRIPT_DIR/../scripts/tag-list-to-tree.py"
    exit 0
    ;;
  *)
    echo "Unknown mode \"$1\"" >&2
    exit 1
    ;;
esac

unset print_mode
unset indent_filter
}

main() {
# parse subcommands
while [[ $# -gt 0 ]]; do
    case "$1" in
        h|help)
            cmd_help
            exit 0
            ;;
        p|print)
            shift
            cmd_print "$@"
            break
            ;;
        *)
            echo "Unknown subcommand: $1" >&2
            exit 1
            ;;
    esac
done
}

main "$@"
