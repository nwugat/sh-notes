#!/usr/bin/env sh

# set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"
source "$SCRIPT_DIR/../lib/tags.sh"
source "$SCRIPT_DIR/../lib/note-names.sh"

selected_tags=$(find_tags | sort | uniq | fzf --multi)

test -z "$selected_tags" && { echo "No tags selected" >&2 ; exit 0; }

files_result="$(find_notes_with_tags "$selected_tags")"

test -z "$files_result" && { echo "No matching files found" >&2 ; exit 0; }

selected_file=$(echo "$files_result" | fzf)

test -z "$selected_file" && { echo "No file selected" >&2 ; exit 0; }

nvim +"cd $NOTES_DIR" "$selected_file"
